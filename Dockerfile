# HCU plugin image. Must be linux/arm64 and carry the metadata label.
FROM --platform=linux/arm64 ghcr.io/homematicip/alpine-node-simple:0.0.1

# Core (image) version — single source of truth for the running version when
# no OTA payload is active. Keep in sync with package.json + LABEL.
ARG HMIP_VERSION=1.3.0

WORKDIR /app

COPY package.json .npmrc ./
COPY package-lock.jso[n] ./
RUN npm install --omit=dev --no-audit --no-fund --loglevel=error

COPY src ./src

# /data is created by the HCU for installed plugins and persists across
# container updates. We write the editable config there.
VOLUME ["/data"]

ENV NODE_ENV=production \
    HMIP_PLUGIN_ID=de.homematicip.plugin.gardena \
    HMIP_DASHBOARD_PORT=8094 \
    HMIP_VERSION=${HMIP_VERSION} \
    NODE_PATH=/app/node_modules \
    LOG_LEVEL=info

# Dashboard / REST + SSE. EXPOSE, HEALTHCHECK and the listen port must match
# (design-spec port registry: Gardena = 8094).
EXPOSE 8094

# The HCU only completes installation once the container reports Docker
# "healthy". Target 127.0.0.1 (not localhost) so it resolves to the IPv4 the
# Node server binds to; BusyBox-wget in the base image supports --quiet/--spider.
# /health is always served on 8094 regardless of the dashboard toggle/port.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget --quiet --spider http://127.0.0.1:8094/health || exit 1

# Boot via the OTA loader (image-only, node-builtins only), NOT index.js
# directly. The loader chooses image vs. OTA payload and guards against
# crash loops.
ENTRYPOINT ["node", "src/bootstrap/loader.js"]

LABEL de.eq3.hmip.plugin.metadata="{\"pluginId\":\"de.homematicip.plugin.gardena\",\"issuer\":\"Fabio Renner\",\"version\":\"1.3.0\",\"hcuMinVersion\":\"1.4.7\",\"scope\":\"CLOUD\",\"friendlyName\":{\"de\":\"Gardena smart system\",\"en\":\"Gardena smart system\"},\"description\":{\"de\":\"Bindet Gardena smart system Geraete (Maeher, Ventile, Steckdosen, Sensoren) ueber die offizielle Husqvarna v2 API in Homematic IP ein.\",\"en\":\"Bridges Gardena smart system devices (mowers, valves, power sockets, sensors) into Homematic IP via the official Husqvarna v2 API.\"},\"settings\":[],\"changelog\":\"1.3.0 - OTA self-update from GitHub releases (stable/experimental channel, manual/auto, crash-loop-safe loader with rollback). New Updates tab in the dashboard. Default dashboard port is now 8094.\n1.2.0 - Dashboard on port 8093 (live status, diagnostics, logs and 360 export), toggle on/off and custom port in the plugin settings; always-on health endpoint so the container stays healthy; robust Gardena reconnect with exponential backoff and 429 rate-limit cooldown; brightness clamp documented (Connect API max 20000 lx).\n1.1.2 - Docs polish: README rewritten cleanly in UTF-8 to fix mojibake on the GitHub repo page.\n1.1.1 - Plugin icon shown in HCUweb (image label), cleaner description.\n1.1.0 - Plugin icon, GitHub link and PayPal donation hint added to plugin metadata, README and HCU description.\\n1.0.0 - Initial public release.\",\"logsEnabled\":true,\"image\":\"\"}"