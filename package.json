{
  "name": "hmip-gardena-plugin",
  "version": "1.3.2",
  "description": "Homematic IP HCU plugin that bridges Gardena smart system devices (mowers, valves, sockets, sensors) into the HMIP app via the official Husqvarna v2 API.",
  "author": "Fabio Renner",
  "license": "Apache-2.0",
  "homepage": "https://github.com/fabiorenner-hub/hmip-hcu-gardena#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiorenner-hub/hmip-hcu-gardena.git"
  },
  "bugs": {
    "url": "https://github.com/fabiorenner-hub/hmip-hcu-gardena/issues"
  },
  "keywords": [
    "homematic",
    "hmip",
    "hcu",
    "gardena",
    "husqvarna",
    "smart-home",
    "irrigation",
    "mower"
  ],
  "main": "src/index.js",
  "scripts": {
    "start": "node src/bootstrap/loader.js",
    "dev": "node --enable-source-maps src/index.js",
    "test": "node --test",
    "build:ota": "node scripts/build-ota.mjs stable",
    "build:ota:exp": "node scripts/build-ota.mjs experimental"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
